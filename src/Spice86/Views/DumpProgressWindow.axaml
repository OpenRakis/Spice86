<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Spice86.ViewModels"
        x:Class="Spice86.Views.DumpProgressWindow"
        x:CompileBindings="True"
        x:DataType="vm:DumpProgressViewModel"
        Width="560"
        Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Saving recorded data"
        Icon="/Views/Assets/Spice86.ico"
        mc:Ignorable="d">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Saving recorded data" />
        <TextBlock Grid.Row="1" Opacity="0.75" Text="{Binding PhaseText}" />
        <ProgressBar Grid.Row="2"
                     Minimum="0"
                     Maximum="{Binding ProgressMaximum}"
                     Value="{Binding ProgressValue}"
                     IsIndeterminate="{Binding IsIndeterminate}"
                     Height="8" />
        <Border Grid.Row="3" Padding="8" BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="MessagesList"
                     ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0" />
        </Border>
    </Grid>
</Window>
