    55                              <1> ;
    56                              <1> ;   Tests Call far by immediate and memory pointers
    57                              <1> ;   Stack must be initilized
    58                              <1> ;   %1: code segment
    59                              <1> ;   Uses: AX, Flags, DS:SI as scratch memory
    60                              <1> ;
    61                              <1> %macro testCallFar 1
    62                              <1> 	mov ax, sp
    63                              <1> 
    64                              <1> 	clc
    65                              <1> 	o16 call word %1:%%farfn16
    66                              <1> 	jnc error
