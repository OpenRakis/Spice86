   198 00007539 020704              <1> db	                     PTE_WRITE,  PTE_PRESENT|PTE_USER|PTE_WRITE,  PF_NOTP|PF_READ |PF_USER
   199 0000753C 020706              <1> db	                     PTE_WRITE,  PTE_PRESENT|PTE_USER|PTE_WRITE,  PF_NOTP|PF_WRITE|PF_USER
   200                              <1> 
