  1501                                  postFF:
  1502                                  ;-------------------------------------------------------------------------------
  1503                                  	POST FF
     5 0000D5E0 B0FF                <1>  mov al, 0x%1
     6 0000D5E2 66BA9909            <1>  mov dx, POST_PORT
     7 0000D5E6 EE                  <1>  out dx, al
  1504                                  ;-------------------------------------------------------------------------------
  1505                                  ;
  1506                                  ;   Testing finished. STOP.
  1507                                  ;
  1508 0000D5E7 FA                      	cli
  1509 0000D5E8 F4                      	hlt
  1510 0000D5E9 EBF5                    	jmp postFF
  1511                                  
  1512                                  ;
  1513                                  ; Default exception handler and error routine
  1514                                  ;
  1515                                  DefaultExcHandler:
  1516                                  error:
  1517                                  	; Failure handler: spin forever instead of halting. A HLT here would stop the
  1518                                  	; machine the same way the successful postFF terminator does, making failure
  1519                                  	; indistinguishable from success (and, under speculative CFG exploration, a HLT
  1520                                  	; baked into this never-taken arm masks divergence). The self-loop keeps a failed
  1521                                  	; run observably stuck instead.
  1522                                  	; CLI is privileged, so it must not run in ring3.
  1523 0000D5EB 668CC8                  	mov ax, cs
  1524                                  	; when in real mode, the jnz will be decoded together with test as
  1525                                  	; "test eax,0xfe750007" (66A9070075FE)
  1526 0000D5EE 66A90700                	test ax, 7     ; 66 A9 07 00
  1527 0000D5F2 75FE                    .ring3: jnz .ring3 ; 75 FE
  1528 0000D5F4 FA                      	cli
  1529 0000D5F5 EBF4                    	jmp error
  1530                                  
