  1482                                  DivExcHandler:
  1483 0000BF17 56                      	push esi
  1484 0000BF18 BE[22980000]            	mov  esi,strDE
  1485 0000BF1D E84FD9FFFF              	call printStr
  1486 0000BF22 5E                      	pop  esi
  1487                                  ;
  1488                                  ;   It's rather annoying that the 80386 treats #DE as a fault rather than a trap, leaving CS:EIP pointing to the
  1489                                  ;   faulting instruction instead of the RET we conveniently placed after it.  So, instead of trying to calculate where
  1490                                  ;   that RET is, we simply set EIP on the stack to point to our own RET.
  1491                                  ;
  1492 0000BF23 C70424[2BBF0000]        	mov  dword [esp], DivExcHandlerRet
  1493 0000BF2A CF                      	iretd
  1494                                  DivExcHandlerRet:
  1495 0000BF2B C3                      	ret
