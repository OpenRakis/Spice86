     1                              <1> ;
     2                              <1> ;   Tests Call near by displacement and register indirect
     3                              <1> ;   Stack must be initilized.
     4                              <1> ;   %1: stack pointer register
     5                              <1> ;   Uses: AX, EBX, Flags
     6                              <1> ;
     7                              <1> %macro testCallNear 1
     8                              <1> 	%ifidni %1,sp
     9                              <1> 	%define spcmp ax
    10                              <1> 	%else
    11                              <1> 	%define spcmp eax
    12                              <1> 	%endif
    13                              <1> 	mov spcmp, %1
    14                              <1> 
    15                              <1> %%rel16:
    16                              <1> 	clc
    17                              <1> 	o16 call word %%nearfn16
    18                              <1> 	jnc error
    19                              <1> 	jmp %%rel32
    20                              <1> %%nearfn16:
    21                              <1> 	sub spcmp, 2
    22                              <1> 	cmp %1, spcmp
    23                              <1> 	jne error
    24                              <1> 	add spcmp, 2
    25                              <1> 	stc
    26                              <1> 	o16 ret
    27                              <1> 	jmp error
    28                              <1> 
    29                              <1> %%rel32:
    30                              <1> 	clc
    31                              <1> 	o32 call dword %%nearfn32
    32                              <1> 	jnc error
    33                              <1> 	jmp %%rm16
    34                              <1> %%nearfn32:
    35                              <1> 	sub spcmp, 4
    36                              <1> 	cmp %1, spcmp
    37                              <1> 	jne error
    38                              <1> 	add spcmp, 4
    39                              <1> 	stc
    40                              <1> 	o32 ret
    41                              <1> 	jmp error
    42                              <1> 
    43                              <1> %%rm16:
    44                              <1> 	clc
    45                              <1> 	mov bx, %%nearfn16
    46                              <1> 	o16 call bx
    47                              <1> 	jnc error
    48                              <1> %%rm32:
    49                              <1> 	clc
    50                              <1> 	mov ebx, %%nearfn32
    51                              <1> 	o32 call ebx
    52                              <1> 	jnc error
    53                              <1> %endmacro
