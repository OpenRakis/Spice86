     1                              <1> ;
     2                              <1> ; Tests for VERR and VERW instructions
     3                              <1> ;
     4                              <1> ; DX = segment selector
     5                              <1> ; BL = expected ZF value on bit 6, other bits to 0
     6                              <1> ;
     7                              <1> testVERRp:
     8 000096D7 88DC                <1> 	mov ah, bl
     9 000096D9 F6D4                <1> 	not ah
    10 000096DB 9E                  <1> 	sahf
    11 000096DC 0F00E2              <1> 	verr dx
    12 000096DF EB08                <1> 	jmp testVERresult
    13                              <1> testVERWp:
    14 000096E1 88DC                <1> 	mov ah, bl
    15 000096E3 F6D4                <1> 	not ah
    16 000096E5 9E                  <1> 	sahf
    17 000096E6 0F00EA              <1> 	verw dx
    18                              <1> testVERresult:
    19 000096E9 9F                  <1> 	lahf
    20 000096EA 80E440              <1> 	and ah, 0x40
    21 000096ED 38E3                <1> 	cmp bl, ah
    22 000096EF 0F85F63E0000        <1> 	jne error
    23 000096F5 C3                  <1> 	ret
    24                              <1> 
    25                              <1> ;
    26                              <1> ; %1 = segment selector
    27                              <1> ; %2 = 0 or 1 (expected ZF result)
    28                              <1> ;
    29                              <1> %macro testVERR 2
    30                              <1> 	mov dx, %1
    31                              <1> 	mov bl, ((%2 & 1) << 6)
    32                              <1> 	call testVERRp
    33                              <1> %endmacro
    34                              <1> %macro testVERW 2
    35                              <1> 	mov dx, %1
    36                              <1> 	mov bx, ((%2 & 1) << 6)
    37                              <1> 	call testVERWp
    38                              <1> %endmacro
