  1467 0000BEFF 4D                      	dec   ebp      ; decrement src count
  1468 0000BF00 75C8                    	jnz   testSrc
  1469 0000BF02 9D                      	popfd
  1470 0000BF03 5F                      	pop   edi         ; ESI -> restored values for src
  1471 0000BF04 5D                      	pop   ebp         ; EBP == restored count of values for src
  1472 0000BF05 8D5B04                  	lea   ebx,[ebx+4] ; EBX -> next dst (without modifying flags)
  1473 0000BF08 E2BD                    	loop  testDst
  1474                                  
  1475 0000BF0A 59                      	pop  ecx
  1476 0000BF0B 01CE                    	add  esi, ecx     ; ESI -> next tableOps entry
  1477 0000BF0D E975FFFFFF              	jmp  testOps
  1478                                  
  1479                                  testDone:
  1480 0000BF12 E9C9160000              	jmp postFF
